{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "yt-comment-card",
  "type": "hyperframes:block",
  "title": "Yt Comment Card",
  "description": "Migrated HyperFrames sub-composition: yt-comment-card.",
  "tags": [
    "auto",
    "hyperframes",
    "migrated"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "routing": {
    "family": "evidence",
    "purpose": "Display an attributed YouTube comment as audience evidence.",
    "useWhen": [
      "A viewer reaction substantiates reception or sentiment."
    ],
    "avoidWhen": [
      "Aggregate comment trends are the real subject."
    ],
    "expects": [
      "Comment, author label, and provenance"
    ],
    "motion": "entrance-only"
  },
