{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "concept-pin",
  "type": "hyperframes:component",
  "title": "Concept Pin",
  "description": "概念锚点｜用落针、深度与涟漪把地点、变量或关键结论立起来。",
  "tags": [
    "3d",
    "aceternity-inspired",
    "anchor",
    "directed-video",
    "pin",
    "teaching"
  ],
  "routing": {
    "family": "emphasis",
    "purpose": "Pin a concise concept label to a precise visual location.",
    "useWhen": [
      "One named idea must stay anchored to its referent."
    ],
    "avoidWhen": [
      "The referent moves unpredictably or needs a full explanation."
    ],
    "expects": [
      "Label text and anchor coordinates"
    ],
    "motion": "entrance-only"
  },
  "files": [
    {
      "path": "concept-pin/component.js",
      "target": "compositions/components/concept-pin/component.js",
      "type": "hyperframes:snippet"
    },
    {
      "path": "fidelity-runtime.js",
      "target": "compositions/components/fidelity-runtime.js",
      "type": "hyperframes:snippet"
    },
    {
      "path": "runtime.js",
      "target": "compositions/components/runtime.js",
      "type": "hyperframes:snippet"
    }
  ]
}
