{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "ui-code-editor",
  "type": "hyperframes:component",
  "title": "Ui Code Editor",
  "description": "interface|Show project-provided code with line highlights as an explicit mock",
  "tags": [
    "demo",
    "directed-video",
    "migrated",
    "ui-mock"
  ],
  "routing": {
    "family": "interface",
    "purpose": "Demonstrate editing or inspecting code in an editor surface.",
    "useWhen": [
      "Cursor position, files, or changes are operational evidence."
    ],
    "avoidWhen": [
      "A static excerpt communicates the same claim."
    ],
    "expects": [
      "Files, code, selection, and editor state"
    ],
    "motion": "stateful"
  },
  "files": [
    {
      "path": "fidelity-runtime.js",
      "target": "compositions/components/fidelity-runtime.js",
      "type": "hyperframes:snippet"
    },
    {
      "path": "runtime.js",
      "target": "compositions/components/runtime.js",
      "type": "hyperframes:snippet"
    },
    {
      "path": "ui-code-editor/component.js",
      "target": "compositions/components/ui-code-editor/component.js",
      "type": "hyperframes:snippet"
    },
    {
      "path": "ui-mock-runtime.js",
      "target": "compositions/components/ui-mock-runtime.js",
      "type": "hyperframes:snippet"
    }
  ]
}
