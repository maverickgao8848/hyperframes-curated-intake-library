{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperframes.local/schemas/curated-storyboard-v3.json",
  "title": "HyperFrames Storyboard v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "duration", "timing_mode", "scenes"],
  "properties": {
    "schema": {"const": "hyperframes-storyboard/v3"},
    "title": {"$ref": "#/$defs/nonEmptyString"},
    "message": {"$ref": "#/$defs/nonEmptyString"},
    "duration": {"type": "number", "exclusiveMinimum": 0},
    "timing_mode": {"enum": ["approximate", "locked"]},
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "sceneId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "catalogOrAuthoredUseId": {"type": "string", "pattern": "^(?:background|font|logo|lottie|motion-rule|registry-block|registry-component|scene-blueprint|sfx|svg|template|texture|transition|authored):[a-z0-9][a-z0-9._/:-]*$"},
    "migrationOnlyRecipeUseId": {"type": "string", "pattern": "^recipe:[a-z0-9][a-z0-9._/:-]*$"},
    "useId": {"anyOf": [{"$ref": "#/$defs/catalogOrAuthoredUseId"}, {"$ref": "#/$defs/migrationOnlyRecipeUseId"}]},
    "use": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "responsibilities", "required"],
      "properties": {
        "id": {"$ref": "#/$defs/useId"},
        "responsibilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "required": {"type": "boolean"}
      }
    },
    "next": {
      "type": "object", "additionalProperties": false,
      "required": ["sceneId", "transition"],
      "properties": {"sceneId": {"$ref": "#/$defs/sceneId"}, "transition": {"$ref": "#/$defs/nonEmptyString"}}
    },
    "sourceAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "anchor"],
      "properties": {"source": {"$ref": "#/$defs/nonEmptyString"}, "anchor": {"$ref": "#/$defs/nonEmptyString"}}
    },
    "locks": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "timing": {"type": "boolean"}, "content": {"type": "boolean"}, "visual": {"type": "boolean"},
        "uses": {"type": "boolean"}, "motion": {"type": "boolean"}, "next": {"type": "boolean"}
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "start", "end", "content", "visual", "uses", "motion"],
      "properties": {
        "id": {"$ref": "#/$defs/sceneId"}, "title": {"$ref": "#/$defs/nonEmptyString"},
        "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0},
        "content": {"$ref": "#/$defs/nonEmptyString"}, "visual": {"$ref": "#/$defs/nonEmptyString"},
        "uses": {"type": "array", "items": {"$ref": "#/$defs/use"}}, "motion": {"$ref": "#/$defs/nonEmptyString"},
        "next": {"$ref": "#/$defs/next"}, "narration": {"$ref": "#/$defs/nonEmptyString"},
        "on_screen_text": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "sfx": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "source_anchor": {"$ref": "#/$defs/sourceAnchor"}, "locks": {"$ref": "#/$defs/locks"}
      }
    },
    "scenePatch": {
      "type": "object", "additionalProperties": false, "minProperties": 3,
      "required": ["segmentId", "sceneId"],
      "properties": {
        "segmentId": {"$ref": "#/$defs/nonEmptyString"}, "sceneId": {"$ref": "#/$defs/sceneId"},
        "title": {"$ref": "#/$defs/nonEmptyString"}, "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0}, "content": {"$ref": "#/$defs/nonEmptyString"},
        "visual": {"$ref": "#/$defs/nonEmptyString"}, "uses": {"type": "array", "items": {"$ref": "#/$defs/use"}},
        "motion": {"$ref": "#/$defs/nonEmptyString"}, "next": {"$ref": "#/$defs/next"},
        "narration": {"$ref": "#/$defs/nonEmptyString"},
        "on_screen_text": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "sfx": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "source_anchor": {"$ref": "#/$defs/sourceAnchor"}, "locks": {"$ref": "#/$defs/locks"}
      }
    }
  }
}
