{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperframes.local/schemas/scene-contract.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sceneId", "compositionSrc", "motionSidecar", "status", "sourceRelation", "animation", "timeline", "purpose", "classification", "visualIntent", "motionIntent", "hero", "construction", "beats", "textPlan", "ambient", "incomingTransition", "assetBindings", "integrations", "candidateIntegrations", "mustPreserve", "qualityTargets"],
  "properties": {
    "schemaVersion": {"const": "hyperframes-scene-contract/v2"},
    "sceneId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "compositionSrc": {"type": "string", "pattern": "^compositions/frames/[a-z0-9-]+\\.html$"},
    "motionSidecar": {"type": "string", "pattern": "^compositions/frames/[a-z0-9-]+\\.motion\\.json$"},
    "status": {"const": "approved"},
    "sourceRelation": {"enum": ["preserve", "augment", "replace", "designed"]},
    "animation": {"enum": ["source-only", "augment", "authored"]},
    "timeline": {"type": "object"},
    "purpose": {"type": "string", "minLength": 1},
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["teachingIntent", "cognitiveAction", "sceneRole", "evidenceType", "density", "narrativeScale", "visualPattern"],
      "properties": {
        "teachingIntent": {"type": "string", "minLength": 1},
        "cognitiveAction": {"type": "string", "minLength": 1},
        "sceneRole": {"type": "string", "minLength": 1},
        "evidenceType": {"type": "string", "minLength": 1},
        "density": {"type": "string", "minLength": 1},
        "narrativeScale": {"enum": ["support-beat", "standard-scene", "chapter-peak"]},
        "visualPattern": {"type": "string", "minLength": 1}
      }
    },
    "visualIntent": {"type": "string", "minLength": 1},
    "motionIntent": {"type": "string", "minLength": 1},
    "hero": {"type": "object"},
    "construction": {"type": "object"},
    "beats": {"type": "array"},
    "textPlan": {"type": "object"},
    "ambient": {"type": "object"},
    "incomingTransition": {"type": ["object", "null"]},
    "assetBindings": {"type": "array"},
    "integrations": {"type": "array"},
    "candidateIntegrations": {"type": "array"},
    "mustPreserve": {"type": "array"},
    "qualityTargets": {"type": "object"}
  }
}
