{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "parentPlanHash", "clusterId", "segmentIds", "lockedDecisions", "segmentUpdates", "scopeChangeProposal"],
  "properties": {
    "schemaVersion": {"const": "hyperframes-visual-director/curated-result-v1"},
    "parentPlanHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "clusterId": {"type": "string"},
    "segmentIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "lockedDecisions": {"type": "array", "items": {"type": "string"}},
    "segmentUpdates": {"type": "array", "items": {"type": "object", "required": ["segmentId", "sceneContracts", "beats", "components", "questionsResolved"], "additionalProperties": false, "properties": {"segmentId": {"type": "string"}, "sceneContracts": {"type": "array", "items": {"type": "string"}}, "beats": {"type": "array"}, "components": {"type": "array"}, "questionsResolved": {"type": "array"}, "scopeChangeProposal": {"type": ["object", "null"]}}}},
    "scopeChangeProposal": {"type": ["object", "null"]}
  }
}

