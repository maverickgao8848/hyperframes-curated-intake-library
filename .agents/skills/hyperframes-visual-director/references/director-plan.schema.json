{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hyperframes.dev/schema/director-plan-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "project", "sources", "timing", "collaborationMode", "visualPolicy", "segments", "edges", "assetRequests", "libraryLock", "approval", "audit"],
  "properties": {
    "schemaVersion": {"const": "hyperframes-visual-director/v1"},
    "revision": {"type": "integer", "minimum": 1},
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "durationFrames", "fps", "width", "height", "aspect"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "durationFrames": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "aspect": {"enum": ["16:9", "9:16", "1:1", "4:3", "custom"]}
      }
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "timing": {
      "type": "object",
      "additionalProperties": true,
      "required": ["precision", "fps", "timingNeedsRefinement"],
      "properties": {
        "precision": {"enum": ["word", "sentence", "estimated"]},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "timingNeedsRefinement": {"type": "boolean"}
      }
    },
    "collaborationMode": {"enum": ["hands-off", "cooperative", "director-led"]},
    "visualPolicy": {"type": "object", "additionalProperties": true},
    "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "assetRequests": {"type": "array", "items": {"$ref": "#/$defs/assetRequest"}},
    "libraryLock": {"type": "object", "additionalProperties": true, "required": ["catalogSha256", "entries"], "properties": {"catalogSha256": {"type": "string", "minLength": 1}, "entries": {"type": "array"}}},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "approvedRevision", "approvedHash"],
      "properties": {
        "state": {"enum": ["draft", "in-review", "approved", "rejected"]},
        "approvedRevision": {"type": ["integer", "null"]},
        "approvedHash": {"type": ["string", "null"]}
      }
    },
    "audit": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "range": {"type": "object", "additionalProperties": false, "required": ["startFrame", "endFrame"], "properties": {"startFrame": {"type": "integer", "minimum": 0}, "endFrame": {"type": "integer", "minimum": 1}}},
    "source": {"type": "object", "additionalProperties": true, "required": ["id", "path", "sha256", "segmentIds"], "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "minLength": 1}, "segmentIds": {"type": "array", "items": {"type": "string"}}}},
    "visual": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "framePolicy", "content", "rationale", "fallback"],
      "properties": {
        "type": {"enum": ["source-footage", "external-evidence", "external-broll", "registry-block", "curated-teaching", "generated-visual"]},
        "catalogId": {"type": "string", "minLength": 1},
        "framePolicy": {"enum": ["frame-governed", "native-evidence", "wrapper-only", "source-preserve"]},
        "content": {"type": "object"},
        "rationale": {"type": "string"},
        "fallback": {"type": "object"}
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "range", "framePolicy", "target", "content"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["camera", "focus", "annotation", "typography", "caption", "host", "environment", "evidence", "audio"]},
        "range": {"$ref": "#/$defs/range"},
        "catalogId": {"type": "string", "minLength": 1},
        "framePolicy": {"enum": ["frame-governed", "native-evidence", "wrapper-only", "source-preserve"]},
        "target": {"type": "string", "minLength": 1},
        "content": {"type": "object"}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "range", "sourceAnchors", "message", "dominantVisual", "layers", "route", "assetRequestIds", "approval"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "range": {"$ref": "#/$defs/range"},
        "sourceAnchors": {"type": "array", "items": {"type": "object", "required": ["kind", "text"], "properties": {"kind": {"enum": ["word", "sentence", "estimated"]}, "text": {"type": "string"}}, "additionalProperties": true}},
        "message": {"type": "string", "minLength": 1},
        "dominantVisual": {"$ref": "#/$defs/visual"},
        "layers": {"type": "array", "items": {"$ref": "#/$defs/layer"}},
        "route": {"enum": ["direct-build", "curated-intake", "media-sourcing", "source-only"]},
        "assetRequestIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "approval": {"type": "object", "additionalProperties": true, "required": ["state"], "properties": {"state": {"enum": ["proposed", "approved", "rejected", "locked"]}}},
        "stale": {"type": "boolean"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "fromSegmentId", "toSegmentId", "boundaryFrame", "kind"],
      "properties": {"id": {"type": "string"}, "fromSegmentId": {"type": "string"}, "toSegmentId": {"type": "string"}, "boundaryFrame": {"type": "integer", "minimum": 1}, "kind": {"type": "string", "minLength": 1}, "catalogId": {"type": "string"}}
    },
    "assetRequest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "priority", "source", "owner", "specification", "segmentIds", "status", "fallback"],
      "properties": {
        "id": {"type": "string"},
        "priority": {"enum": ["required", "recommended", "optional"]},
        "source": {"enum": ["user", "external", "generated", "existing"]},
        "owner": {"type": "string"},
        "specification": {"type": "string"},
        "segmentIds": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["open", "linked", "waived", "ready"]},
        "fallback": {"type": "object"}
      }
    }
  }
}
