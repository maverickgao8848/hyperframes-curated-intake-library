{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenes", "boundaries", "custom"],
  "properties": {
    "schemaVersion": {"const": "hyperframes-curated-usage/v3"},
    "scenes": {"type": "array", "items": {"$ref": "#/$defs/sceneEvidence"}},
    "boundaries": {"type": "array", "items": {"$ref": "#/$defs/boundary"}},
    "custom": {"type": "array"}
  },
  "$defs": {
    "sceneEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "useEvidence", "motionEvidence", "missIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "useEvidence": {"type": "array", "items": {"$ref": "#/$defs/useEvidence"}},
        "motionEvidence": {
          "type": "object", "additionalProperties": false,
          "required": ["opening", "settled"],
          "properties": {
            "opening": {"type": "string", "minLength": 1},
            "internalChange": {"type": "string", "minLength": 1},
            "settled": {"type": "string", "minLength": 1},
            "finalHold": {"type": "string", "minLength": 1}
          }
        },
        "missIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "useEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "mounted", "sourcePath"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "mounted": {"const": true},
        "sourcePath": {"type": "string", "minLength": 1}
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["fromScene", "toScene", "transition", "snapshots"],
      "properties": {
        "fromScene": {"type": "string", "minLength": 1},
        "toScene": {"type": "string", "minLength": 1},
        "transition": {"type": "string", "minLength": 1},
        "snapshots": {
          "type": "object", "additionalProperties": false,
          "required": ["outgoing", "midpoint", "incoming"],
          "properties": {
            "outgoing": {"type": "string", "minLength": 1},
            "midpoint": {"type": "string", "minLength": 1},
            "incoming": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
