{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperframes.local/schemas/curated-intake-result-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "parentPlanHash", "clusterId", "requestedSegmentIds", "scenePatches", "catalogMisses", "scopeChangeProposal"],
  "properties": {
    "schemaVersion": {"const": "hyperframes-visual-director/curated-result-v3"},
    "parentPlanHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "clusterId": {"type": "string", "minLength": 1},
    "requestedSegmentIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scenePatches": {"type": "array", "items": {"$ref": "https://hyperframes.local/schemas/curated-storyboard-v3.json#/$defs/scenePatch"}},
    "catalogMisses": {"type": "array"},
    "scopeChangeProposal": {"type": ["object", "null"]}
  }
}
